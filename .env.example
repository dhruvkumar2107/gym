# ===== Zacson Fitness - Environment Variables =====

# Server
PORT=3000

# Comma-separated list of allowed origins for CORS (default: all origins)
CORS_ORIGINS=

# Auth
# IMPORTANT: set a stable 32+ char secret in production. If unset, a random
# secret is generated on boot and all sessions invalidate on restart.
JWT_SECRET=

# Allow password reset tokens to be returned in the JSON response (dev only)
ALLOW_RESET_TOKEN_IN_RESPONSE=false

# Public base URL used in emails/links (e.g. https://zacsonfitness.com)
APP_URL=https://zacsonfitness.com

# Email (SMTP). Emails are only sent when FROM_EMAIL is set.
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Turso (remote database). When both are set the app uses Turso; otherwise it
# uses a local SQLite file (sql.js). Deployed on Vercel the local file is
# ephemeral (/tmp), so set these for persistent data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Razorpay payments. When unset, online payment endpoints return a 503 with a
# clear "configure Razorpay" message and cash/UPI checkout still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Vercel runtime marker (set automatically by Vercel)
VERCEL=